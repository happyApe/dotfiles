{
  "lastChangelogVersion": "0.75.5",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "defaultThinkingLevel": "medium",
  "theme": "neovim-onedark-cool",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:@plannotator/pi-extension",
    "git:github.com/jonjonrankin/pi-caveman",
    "npm:@gotgenes/pi-permission-system",
    {
      "source": "git:github.com/mitsuhiko/agent-stuff",
      "extensions": [
        "extensions/files.ts",
        "extensions/notify.ts",
        "extensions/prompt-editor.ts",
        "extensions/session-breakdown.ts",
        "extensions/split-fork.ts"
      ],
      "skills": [
        "skills/frontend-design/**",
        "skills/github/**",
        "skills/tmux/**",
        "skills/uv/**",
        "skills/uv/**"
      ],
      "prompts": [],
      "themes": []
    },
    "npm:@juicesharp/rpiv-todo",
    "git:github.com/multica-ai/andrej-karpathy-skills",
    "npm:@apmantza/greedysearch-pi",
    "npm:@wierdbytes/pi-facelift",
    "npm:pi-ui-hephaestus",
    "npm:pi-slopchop"
  ],
  "hephaestus": {
    "mutedTheme": false,
    "codeUnindent": true,
    "labelText": "Thinking...",
    "labelColor": "255,215,0",
    "animationStyle": "wave",
    "diffTheme": "github-dark ",
    "diffSplitMinWidth": 150,
    "diffSplitMinCodeWidth": 60
  }
